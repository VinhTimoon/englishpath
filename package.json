{
  "name": "englishpath",
  "version": "1.0.0",
  "private": true,
  "description": "EnglishPath - free-first English learning platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "format:check": "pnpm --dir apps/api exec prettier --check ../../package.json ../../docs/12_DEPLOYMENT_PLAN.md ../../_bmad-output/planning-artifacts/epic-map.md ../../_bmad-output/planning-artifacts/story-map.md ../../scripts/planning-traceability.mjs ../../scripts/run-checks.mjs ../../scripts/tests/*.mjs ../../.github/workflows/*.yml",
    "lint": "turbo lint",
    "planning:traceability": "node scripts/planning-traceability.mjs",
    "tool:test": "node --test scripts/tests/story-tools.test.mjs scripts/tests/planning-traceability.test.mjs",
    "prisma:validate": "node scripts/run-checks.mjs --prisma-only",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "story:doctor": "node scripts/story-doctor.mjs",
    "story:prompt": "node scripts/create-codex-prompt.mjs",
    "story:verify": "node scripts/verify-story.mjs",
    "story:checks": "node scripts/run-checks.mjs",
    "story:loop": "node scripts/codex-loop.mjs",
    "story:plan": "node scripts/codex-runner.mjs plan .codex-plan-task.md",
    "story:build": "node scripts/codex-runner.mjs build .codex-build-task.md",
    "story:review": "node scripts/codex-runner.mjs review .codex-review-task.md",
    "story:test": "node scripts/run-story-tests.mjs"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.1",
      "onFail": "download"
    }
  }
}
