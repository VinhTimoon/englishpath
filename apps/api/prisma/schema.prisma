generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  legacyName                  String?                      @map("name")
  authProvider                IdentityProvider             @default(SUPABASE)
  externalSubject             String?
  status                      UserStatus                   @default(ACTIVE)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  profile                     UserProfile?
  roleAssignments             UserRole[]                   @relation("AssignedUserRoles")
  roleAssignmentsAuthored     UserRole[]                   @relation("RoleAssignmentActor")
  onboarding                  LearnerOnboarding?
  placementAttempts           PlacementAttempt[]
  roadmaps                    Roadmap[]
  practiceSessions            PracticeSession[]
  learnerProgress             LearnerProgress?
  errorNotebookEntries        ErrorNotebookEntry[]
  dailySentenceCompletions    DailySentenceCompletion[]
  vocabularyMasteryStates     VocabularyMasteryState[]
  vocabularyReviewSubmissions VocabularyReviewSubmission[]
  privilegedAuditEvents       PrivilegedAuditEvent[]
  toeicPracticeSessions       ToeicPracticeSession[]
  toeicReadingPracticeSessions ToeicReadingPracticeSession[]
  toeicTimedTestSessions       ToeicTimedTestSession[]

  @@unique([authProvider, externalSubject])
  @@index([status])
}

model LearnerOnboarding {
  userId         String           @id
  primaryGoal    LearningGoal
  secondaryGoals LearningGoal[]
  currentLevel   ProficiencyLevel
  dailyMinutes   Int
  targetDays     Int
  prioritySkills LearningSkill[]
  completedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlacementAttempt {
  id                 String           @id @default(cuid())
  userId             String
  clientSubmissionId String
  answers            Json
  score              Int
  total              Int
  level              ProficiencyLevel
  skillBreakdown     Json
  submittedAt        DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientSubmissionId])
  @@index([userId, submittedAt])
}

model Roadmap {
  id                String           @id @default(cuid())
  userId            String
  version           Int
  goal              LearningGoal
  level             ProficiencyLevel
  durationDays      Int
  dailyMinutes      Int
  status            RoadmapStatus    @default(ACTIVE)
  previousRoadmapId String?
  generatedAt       DateTime         @default(now())
  supersededAt      DateTime?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousRoadmap   Roadmap?         @relation("RoadmapLineage", fields: [previousRoadmapId], references: [id], onDelete: SetNull)
  nextRoadmaps      Roadmap[]        @relation("RoadmapLineage")
  items             RoadmapItem[]

  @@unique([userId, version])
  @@index([userId, status])
  @@index([previousRoadmapId])
}

model RoadmapItem {
  id          String            @id @default(cuid())
  roadmapId   String
  dayNumber   Int
  sequence    Int
  phase       RoadmapPhase
  skill       LearningSkill
  taskType    RoadmapTaskType
  title       String
  minutes     Int
  status      RoadmapItemStatus @default(PENDING)
  completedAt DateTime?
  roadmap     Roadmap           @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, dayNumber, sequence])
  @@index([roadmapId, dayNumber, status])
}

model PracticeSession {
  id              String               @id @default(cuid())
  userId          String
  clientSessionId String
  practiceDay     DateTime
  questionIds     String[]
  status          PracticeStatus       @default(ACTIVE)
  score           Int                  @default(0)
  total           Int                  @default(5)
  xpAwarded       Int                  @default(0)
  startedAt       DateTime             @default(now())
  submittedAt     DateTime?
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         PracticeAnswer[]
  errors          ErrorNotebookEntry[]

  @@unique([userId, clientSessionId])
  @@unique([userId, practiceDay])
  @@index([userId, status, startedAt])
}

model PracticeAnswer {
  id             String          @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  answeredAt     DateTime        @default(now())
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model LearnerProgress {
  userId         String    @id
  xp             Int       @default(0)
  streakDays     Int       @default(0)
  lastPracticeOn DateTime?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ErrorNotebookEntry {
  id             String          @id @default(cuid())
  userId         String
  sessionId      String
  questionId     String
  prompt         String
  selectedOption String
  correctOption  String
  explanation    String
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([userId, createdAt])
}

model UserProfile {
  userId      String   @id
  displayName String?
  avatarUrl   String?
  locale      String   @default("vi-VN")
  timezone    String   @default("Asia/Ho_Chi_Minh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GovernedSentence {
  id             String                    @id
  prompt         String
  expectedAnswer String
  source         String
  license        String
  reviewStatus   String
  reviewedAt     DateTime
  publishStatus  String
  publishedAt    DateTime
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  completions    DailySentenceCompletion[]

  @@index([reviewStatus, publishStatus, publishedAt])
}

model GovernedVocabularyItem {
  id                String                       @id
  taxonomyNodeId    String
  word              String
  meaning           String
  example           String?
  pronunciation     String?
  source            String
  license           String
  reviewStatus      String
  reviewedAt        DateTime
  publishStatus     String
  publishedAt       DateTime
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  masteryStates     VocabularyMasteryState[]
  reviewSubmissions VocabularyReviewSubmission[]

  @@index([taxonomyNodeId, reviewStatus, publishStatus, publishedAt])
  @@index([word])
}

model CmsTaxonomyNode {
  id               String              @id
  parentId         String?
  level            String
  topic            String
  subtopic         String?
  collocations     String[]
  relatedSkills    String[]
  tracks           String[]
  toeicParts       Int[]
  createdByActorId String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  parent           CmsTaxonomyNode?    @relation("CmsTaxonomyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         CmsTaxonomyNode[]   @relation("CmsTaxonomyTree")
  contentVersions  CmsContentVersion[]

  @@index([parentId, level, topic])
}

model CmsContent {
  id        String              @id
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  versions  CmsContentVersion[]
}

model CmsContentVersion {
  id                  String              @id
  contentId           String
  previousVersionId   String?
  clientRequestId     String
  contentType         String
  title               String
  body                String
  createdByActorId    String
  provenance          String
  usageScope          String
  accessTier          String
  taxonomyNodeId      String
  sourceId            String
  sourceUrl           String?
  checksum            String
  sourceVersion       String
  rightsOwner         String
  licenseStatus       String
  allowedUsageScopes  String[]
  allowedAccessTiers  String[]
  validUntil          DateTime?
  reviewStatus        String              @default("draft")
  publishStatus       String              @default("draft")
  reviewDecision      String?
  reviewerId          String?
  reviewedAt          DateTime?
  reviewContentId     String?
  reviewVersionId     String?
  reviewChecksum      String?
  reviewSourceVersion String?
  publishedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  content             CmsContent          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  previousVersion     CmsContentVersion?  @relation("CmsVersionLineage", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions        CmsContentVersion[] @relation("CmsVersionLineage")
  taxonomyNode        CmsTaxonomyNode     @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)

  @@unique([contentId, clientRequestId])
  @@index([taxonomyNodeId, reviewStatus, publishStatus])
  @@index([contentId, createdAt])
}

model DailySentenceCompletion {
  id              String           @id @default(cuid())
  userId          String
  sentenceId      String
  localDate       DateTime
  submittedAnswer String
  isCorrect       Boolean
  feedback        String
  completedAt     DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentence        GovernedSentence @relation(fields: [sentenceId], references: [id], onDelete: Restrict)

  @@unique([userId, localDate])
  @@index([userId, localDate])
  @@index([sentenceId])
}

model VocabularyMasteryState {
  id             String                 @id @default(cuid())
  userId         String
  vocabularyId   String
  mastery        Int                    @default(0)
  repetitions    Int                    @default(0)
  intervalDays   Int                    @default(0)
  nextReviewAt   DateTime               @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     GovernedVocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewAt, vocabularyId])
}

model VocabularyReviewSubmission {
  id                 String                 @id @default(cuid())
  userId             String
  vocabularyId       String
  clientSubmissionId String
  quality            Int
  result             Json
  createdAt          DateTime               @default(now())
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary         GovernedVocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId, clientSubmissionId])
  @@index([userId, createdAt])
}

model Role {
  id          String     @id @default(cuid())
  code        RoleCode   @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignments UserRole[]
}

model UserRole {
  userId           String
  roleId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?
  assignmentReason String?
  user             User     @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?    @relation("RoleAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

model PrivilegedAuditEvent {
  id            String            @id @default(cuid())
  actorUserId   String?
  action        String
  target        String
  policyResult  AuditPolicyResult
  correlationId String
  attributes    Json
  occurredAt    DateTime          @default(now())
  actor         User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([correlationId])
}

model ToeicQuestion {
  id        String                @id
  versions ToeicQuestionVersion[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model ToeicQuestionVersion {
  id                  String                   @id
  questionId          String
  version             Int
  previousVersionId   String?
  importIdentity      String
  part                ToeicPart
  questionType        ToeicQuestionType
  difficulty          ToeicDifficulty
  topic               String?
  stimulusGroup       String?
  prompt              String
  options             Json
  mediaReference      String?
  explanation         String?
  correctAnswer       String
  sourceIdentity      String
  sourceUrl           String?
  checksum            String
  sourceVersion       String
  provenance          String
  rightsOwner         String
  licenseStatus       ToeicLicenseStatus
  allowedUsageScopes  ToeicUsageScope[]
  accessTier          ToeicAccessTier
  reviewStatus        ToeicReviewStatus       @default(DRAFT)
  reviewDecision      ToeicReviewDecision?
  reviewEvidence      String?
  reviewerIdentity    String?
  reviewedAt          DateTime?
  publicationState    ToeicPublicationState   @default(UNPUBLISHED)
  publishedAt         DateTime?
  validUntil          DateTime?
  createdAt           DateTime                @default(now())
  question            ToeicQuestion           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  previousVersion     ToeicQuestionVersion?   @relation("ToeicVersionLineage", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions        ToeicQuestionVersion[]  @relation("ToeicVersionLineage")

  @@unique([questionId, version])
  @@unique([sourceIdentity, checksum, sourceVersion])
  @@unique([importIdentity])
  @@index([questionId, version])
  @@index([part, questionType, difficulty])
  @@index([reviewStatus, publicationState, publishedAt, validUntil])
  @@index([stimulusGroup])
}

model ToeicPracticeSession {
  id              String                   @id @default(cuid())
  userId          String
  clientSessionId String
  listeningPart   ToeicPart?
  difficulty      ToeicDifficulty?
  questionIds     String[]
  status          ToeicPracticeStatus      @default(ACTIVE)
  total           Int
  score           Int?
  startedAt       DateTime                 @default(now())
  submittedAt     DateTime?
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         ToeicPracticeAnswer[]
  @@unique([userId, clientSessionId])
  @@index([userId, status])
  @@index([id])
}

model ToeicPracticeAnswer {
  id             String              @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  answeredAt     DateTime            @default(now())
  session        ToeicPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model ToeicReadingPracticeSession {
  id              String              @id @default(cuid())
  userId          String
  clientSessionId String
  readingPart     ToeicPart?
  difficulty      ToeicDifficulty?
  topic           String?
  questionIds     String[]
  status          ToeicPracticeStatus @default(ACTIVE)
  total           Int
  score           Int?
  startedAt       DateTime            @default(now())
  submittedAt     DateTime?
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         ToeicReadingPracticeAnswer[]
  @@unique([userId, clientSessionId])
  @@index([userId, status])
}

model ToeicReadingPracticeAnswer {
  id             String                       @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  answeredAt     DateTime                     @default(now())
  session        ToeicReadingPracticeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model ToeicTimedTestSession {
  id              String                 @id @default(cuid())
  userId          String
  clientSessionId String
  mode            ToeicTimedTestMode
  policyVersion   String
  questionIds     String[]
  startedAt       DateTime
  deadlineAt      DateTime
  status          ToeicTimedTestStatus    @default(ACTIVE)
  total           Int
  score           Int?
  finalizedAt     DateTime?
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         ToeicTimedTestAnswer[]
  @@unique([userId, clientSessionId])
  @@index([userId, status])
  @@index([deadlineAt, status])
}

model ToeicTimedTestAnswer {
  id             String                @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  answeredAt     DateTime              @default(now())
  session        ToeicTimedTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, questionId])
  @@index([sessionId])
}

enum IdentityProvider {
  SUPABASE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  RETAINED
}

enum RoleCode {
  FREE_USER
  PREMIUM_USER
  CONTENT_EDITOR
  ADMIN
  SUPER_ADMIN
}

enum AuditPolicyResult {
  ALLOW
  DENY
}

enum ToeicPart {
  PART_1
  PART_2
  PART_3
  PART_4
  PART_5
  PART_6
  PART_7
}
enum ToeicQuestionType {
  PHOTO_DESCRIPTION
  QUESTION_RESPONSE
  CONVERSATION
  TALK
  INCOMPLETE_SENTENCE
  TEXT_COMPLETION
  READING_COMPREHENSION
}
enum ToeicDifficulty {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}
enum ToeicLicenseStatus {
  UNKNOWN
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}
enum ToeicReviewStatus {
  DRAFT
  IN_REVIEW
  REVIEWED
  REJECTED
}
enum ToeicReviewDecision {
  APPROVE
  REJECT
  REQUEST_CHANGES
}
enum ToeicPublicationState {
  UNPUBLISHED
  PUBLISHED
  RETIRED
}
enum ToeicUsageScope {
  PRACTICE
  MOCK_TEST
  EXAM
  REVIEW
}
enum ToeicAccessTier {
  FREE
  PREMIUM
  INTERNAL
}

enum ToeicTimedTestMode {
  MINI
  HALF
}

enum ToeicTimedTestStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
}

enum ToeicPracticeStatus {
  ACTIVE
  SUBMITTED
}

enum LearningGoal {
  ENGLISH_FOUNDATION
  DAILY_COMMUNICATION
  FOUR_SKILL_ENGLISH
  WORKPLACE_ENGLISH
  TOEIC_LISTENING_READING
  TOEIC_SPEAKING_WRITING
  TOEIC_FOUR_SKILLS
}

enum ProficiencyLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum LearningSkill {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
  SPEAKING
  WRITING
}

enum RoadmapStatus {
  ACTIVE
  SUPERSEDED
}

enum RoadmapPhase {
  FOUNDATION
  SKILL_BUILDING
  PRACTICE_CORRECTION
  SIMULATION_REVIEW
}

enum RoadmapTaskType {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
  SPEAKING
  WRITING
  DAILY_SENTENCE
  TOEIC_PART
  REVIEW
  SIMULATION
}

enum RoadmapItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum PracticeStatus {
  ACTIVE
  SUBMITTED
}
