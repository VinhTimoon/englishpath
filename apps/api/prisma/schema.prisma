generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String             @id @default(cuid())
  email                   String             @unique
  legacyName              String?            @map("name")
  authProvider            IdentityProvider   @default(SUPABASE)
  externalSubject         String?
  status                  UserStatus         @default(ACTIVE)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  profile                 UserProfile?
  roleAssignments         UserRole[]         @relation("AssignedUserRoles")
  roleAssignmentsAuthored UserRole[]         @relation("RoleAssignmentActor")
  onboarding              LearnerOnboarding?
  placementAttempts       PlacementAttempt[]
  roadmaps                Roadmap[]

  @@unique([authProvider, externalSubject])
  @@index([status])
}

model LearnerOnboarding {
  userId         String           @id
  primaryGoal    LearningGoal
  secondaryGoals LearningGoal[]
  currentLevel   ProficiencyLevel
  dailyMinutes   Int
  targetDays     Int
  prioritySkills LearningSkill[]
  completedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlacementAttempt {
  id                 String           @id @default(cuid())
  userId             String
  clientSubmissionId String
  answers            Json
  score              Int
  total              Int
  level              ProficiencyLevel
  skillBreakdown     Json
  submittedAt        DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientSubmissionId])
  @@index([userId, submittedAt])
}

model Roadmap {
  id                String           @id @default(cuid())
  userId            String
  version           Int
  goal              LearningGoal
  level             ProficiencyLevel
  durationDays      Int
  dailyMinutes      Int
  status            RoadmapStatus    @default(ACTIVE)
  previousRoadmapId String?
  generatedAt       DateTime         @default(now())
  supersededAt      DateTime?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousRoadmap   Roadmap?         @relation("RoadmapLineage", fields: [previousRoadmapId], references: [id], onDelete: SetNull)
  nextRoadmaps      Roadmap[]        @relation("RoadmapLineage")
  items             RoadmapItem[]

  @@unique([userId, version])
  @@index([userId, status])
  @@index([previousRoadmapId])
}

model RoadmapItem {
  id          String            @id @default(cuid())
  roadmapId   String
  dayNumber   Int
  sequence    Int
  phase       RoadmapPhase
  skill       LearningSkill
  taskType    RoadmapTaskType
  title       String
  minutes     Int
  status      RoadmapItemStatus @default(PENDING)
  completedAt DateTime?
  roadmap     Roadmap           @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, dayNumber, sequence])
  @@index([roadmapId, dayNumber, status])
}

model UserProfile {
  userId      String   @id
  displayName String?
  avatarUrl   String?
  locale      String   @default("vi-VN")
  timezone    String   @default("Asia/Ho_Chi_Minh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String     @id @default(cuid())
  code        RoleCode   @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignments UserRole[]
}

model UserRole {
  userId           String
  roleId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?
  assignmentReason String?
  user             User     @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?    @relation("RoleAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

enum IdentityProvider {
  SUPABASE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  RETAINED
}

enum RoleCode {
  FREE_USER
  PREMIUM_USER
  CONTENT_EDITOR
  ADMIN
  SUPER_ADMIN
}

enum LearningGoal {
  ENGLISH_FOUNDATION
  DAILY_COMMUNICATION
  FOUR_SKILL_ENGLISH
  WORKPLACE_ENGLISH
  TOEIC_LISTENING_READING
  TOEIC_SPEAKING_WRITING
  TOEIC_FOUR_SKILLS
}

enum ProficiencyLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum LearningSkill {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
  SPEAKING
  WRITING
}

enum RoadmapStatus {
  ACTIVE
  SUPERSEDED
}

enum RoadmapPhase {
  FOUNDATION
  SKILL_BUILDING
  PRACTICE_CORRECTION
  SIMULATION_REVIEW
}

enum RoadmapTaskType {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
  SPEAKING
  WRITING
  DAILY_SENTENCE
  TOEIC_PART
  REVIEW
  SIMULATION
}

enum RoadmapItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}
