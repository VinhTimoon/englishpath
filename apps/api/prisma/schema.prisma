generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String           @id @default(cuid())
  email                   String           @unique
  legacyName              String?          @map("name")
  authProvider            IdentityProvider @default(SUPABASE)
  externalSubject         String?
  status                  UserStatus       @default(ACTIVE)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  profile                 UserProfile?
  roleAssignments         UserRole[]       @relation("AssignedUserRoles")
  roleAssignmentsAuthored UserRole[]       @relation("RoleAssignmentActor")

  @@unique([authProvider, externalSubject])
  @@index([status])
}

model UserProfile {
  userId      String   @id
  displayName String?
  avatarUrl   String?
  locale      String   @default("vi-VN")
  timezone    String   @default("Asia/Ho_Chi_Minh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String     @id @default(cuid())
  code        RoleCode   @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignments UserRole[]
}

model UserRole {
  userId           String
  roleId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?
  assignmentReason String?
  user             User     @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?    @relation("RoleAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

enum IdentityProvider {
  SUPABASE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  RETAINED
}

enum RoleCode {
  FREE_USER
  PREMIUM_USER
  CONTENT_EDITOR
  ADMIN
  SUPER_ADMIN
}
